{% load static %}{
  "name": "{{ LIBRARY_NAME|default:'Smart Library' }} — Kitobxon",
  "short_name": "{{ LIBRARY_NAME|default:'Kutubxona' }}",
  "description": "Qo'lingizdagi kitoblar, qaytarish muddatlari va kitob bo'yicha testlar.",
  "lang": "uz",
  "dir": "ltr",
  "start_url": "/testlar/kabinet/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f4f7fb",
  "theme_color": "#1e3a5f",
  "categories": ["education", "books"],
  "icons": [
    {
      "src": "{% static 'img/icon-192.png' %}",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/icon-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "{% static 'img/icon-maskable-512.png' %}",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Testlarim",
      "short_name": "Testlar",
      "url": "/testlar/kabinet/"
    },
    {
      "name": "Kirish",
      "short_name": "Kirish",
      "url": "/testlar/kirish/"
    }
  ]
}
