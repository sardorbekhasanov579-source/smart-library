# Bu namuna fayl. Nusxa olib `.env` nomi bilan saqlang va to'ldiring.
# `.env` fayli GitHub'ga TUSHMAYDI (.gitignore da).
#
# Eslatma: Telegram tokeni va AI kaliti Sozlamalar bo'limidan ham
# kiritilishi mumkin — o'shanda bu yerga yozish shart emas.

# --- Django ---------------------------------------------------------------
DJANGO_SECRET_KEY=ozingizning-uzun-maxfiy-kalitingiz
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Serverda (DEBUG=0 bo'lganda) to'ldiriladi:
# DJANGO_ALLOWED_HOSTS=kutubxona.onrender.com
# DJANGO_CSRF_TRUSTED_ORIGINS=https://kutubxona.onrender.com
# DJANGO_SSL_REDIRECT=1

# --- Ma'lumotlar bazasi ---------------------------------------------------
# Lokal kompyuterda bo'sh qoldirsangiz SQLite ishlatiladi.
# Serverda PostgreSQL manzili beriladi:
# DATABASE_URL=postgres://foydalanuvchi:parol@host:5432/baza?sslmode=require

# --- Telegram -------------------------------------------------------------
# TELEGRAM_BOT_TOKEN=123456789:AAH...
# TELEGRAM_ADMIN_CHAT_ID=123456789

# --- AI savol generatori --------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
